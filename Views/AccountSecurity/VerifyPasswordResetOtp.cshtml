@model Kafo.Web.ViewModels.Authentication.PasswordResetOtpViewModel
@{
    Layout = null;
    var isAdmin = string.Equals(Model.PortalType, "Admin", StringComparison.OrdinalIgnoreCase);
    var forgotUrl = isAdmin ? "/Admin/ForgotPassword" : "/Portal/ForgotPassword";
    var loginUrl = isAdmin ? "/Admin/Login" : "/Portal/Login";
}
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script src="~/js/accessibility-preferences.js" asp-append-version="true"></script>
    <meta name="robots" content="noindex,nofollow" />
    <title>التحقق من البريد | جمعية كفو</title>
    <link rel="stylesheet" href="~/css/account-security.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/accessibility-preferences.css" asp-append-version="true" />
</head>
<body class="account-security-body">
    @await Html.PartialAsync("~/Views/Shared/_AccessibilityControls.cshtml")
<main class="account-security-card">
        <img class="account-security-logo" src="/images/logo1.png" alt="جمعية كفو" />
        <h1>التحقق من البريد الإلكتروني</h1>
        <p>أدخل الرمز المرسل إلى البريد <strong dir="ltr">@Model.MaskedEmail</strong>.</p>

        <div class="account-security-note">
            إذا كان البريد مرتبطًا بحساب فعال فسيصل الرمز خلال دقائق، وصلاحيته 10 دقائق.
        </div>

        @if (TempData["PasswordResetMessage"] is string resetMessage)
        {
            <div class="account-security-alert success">@resetMessage</div>
        }
        @if (TempData["PasswordResetError"] is string resetError)
        {
            <div class="account-security-alert error">@resetError</div>
        }

        <form method="post" action="/Account/VerifyPasswordResetOtp" novalidate>
            @Html.AntiForgeryToken()
            <input asp-for="ChallengeId" type="hidden" />
            <input asp-for="PortalType" type="hidden" />
            <input asp-for="MaskedEmail" type="hidden" />
            <input asp-for="ExpiresAtUtc" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="account-security-alert error"></div>

            <div class="account-security-field account-security-code">
                <label asp-for="Code"></label>
                <input asp-for="Code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" placeholder="000000" />
                <span asp-validation-for="Code"></span>
            </div>

            <button class="account-security-button" type="submit">تحقق ومتابعة</button>
        </form>

        <div class="account-security-actions">
            <form method="post" action="/Account/ResendPasswordResetOtp">
                @Html.AntiForgeryToken()
                <input type="hidden" name="challengeId" value="@Model.ChallengeId" />
                <input type="hidden" name="portalType" value="@Model.PortalType" />
                <button class="account-security-link-button" type="submit">إعادة إرسال الرمز</button>
            </form>
            <a href="@forgotUrl">استخدام بريد آخر</a>
            <a href="@loginUrl">العودة للدخول</a>
        </div>
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
