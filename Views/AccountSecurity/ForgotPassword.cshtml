@model Kafo.Web.ViewModels.Authentication.ForgotPasswordViewModel
@{
    Layout = null;
    var isAdmin = string.Equals(Model.PortalType, "Admin", StringComparison.OrdinalIgnoreCase);
    var title = isAdmin ? "استعادة دخول الإدارة" : "استعادة دخول البوابة الموحدة";
    var submitUrl = isAdmin ? "/Admin/ForgotPassword" : "/Portal/ForgotPassword";
    var loginUrl = isAdmin ? "/Admin/Login" : "/Portal/Login";
}
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script src="~/js/accessibility-preferences.js" asp-append-version="true"></script>
    <meta name="robots" content="noindex,nofollow" />
    <title>@title | جمعية كفو</title>
    <link rel="stylesheet" href="~/css/account-security.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/accessibility-preferences.css" asp-append-version="true" />
</head>
<body class="account-security-body">
    @await Html.PartialAsync("~/Views/Shared/_AccessibilityControls.cshtml")
<main class="account-security-card">
        <img class="account-security-logo" src="/images/logo1.png" alt="جمعية كفو" />
        <h1>@title</h1>
        <p>أدخل البريد الإلكتروني المرتبط بحسابك وسنرسل رمز تحقق لاستعادة كلمة المرور.</p>

        @if (TempData["PasswordResetError"] is string resetError)
        {
            <div class="account-security-alert error">@resetError</div>
        }

        <form method="post" action="@submitUrl" novalidate>
            @Html.AntiForgeryToken()
            <input asp-for="PortalType" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="account-security-alert error"></div>

            <div class="account-security-field">
                <label asp-for="Email"></label>
                <input asp-for="Email" type="email" autocomplete="email" dir="ltr" placeholder="name@example.com" />
                <span asp-validation-for="Email"></span>
            </div>

            <button class="account-security-button" type="submit">إرسال رمز التحقق</button>
        </form>

        <div class="account-security-secondary">
            <a href="@loginUrl">العودة إلى تسجيل الدخول</a>
        </div>
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
