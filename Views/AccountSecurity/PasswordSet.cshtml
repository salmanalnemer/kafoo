@{ Layout = null; var loginUrl = ViewBag.LoginUrl as string ?? "/Portal/Login"; }
<!doctype html><html lang="ar" dir="rtl"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
