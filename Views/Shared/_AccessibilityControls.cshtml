<div class="kafo-theme-control"
     data-kafo-theme-control
     role="group"
     aria-label="إعدادات المظهر">
    <button type="button"
            class="kafo-theme-toggle"
            data-kafo-theme-toggle
            aria-pressed="false"
            aria-label="تفعيل الوضع الداكن"
            title="تفعيل الوضع الداكن">
        <span class="kafo-theme-icon kafo-theme-icon-moon" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false">
                <path d="M20.4 15.6A8.5 8.5 0 0 1 8.4 3.6 8.5 8.5 0 1 0 20.4 15.6Z"></path>
            </svg>
        </span>
        <span class="kafo-theme-icon kafo-theme-icon-sun" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false">
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path>
            </svg>
        </span>
    </button>

    <span class="kafo-theme-status"
          data-kafo-theme-status
          role="status"
          aria-live="polite"
          aria-atomic="true"></span>
</div>
